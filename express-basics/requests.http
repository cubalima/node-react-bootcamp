Content-Type: application/json

{
  "name": "Carlos",
  "position": "Backend Developer",
  "department": "Engineering",
  "salary": 85000
}
### valid employee without optional field --> 201
POST http://localhost:3000/employees
Content-Type: application/json

{
  "name": "Carlos",
  "position": "Backend Developer",
  "salary": 85000
}
